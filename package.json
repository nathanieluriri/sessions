{
  "name": "sessions",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed:sql": "node scripts/make-seed.mjs > migrations/0002_seed.sql",
    "db:migrate:local": "wrangler d1 migrations apply sessions-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply sessions-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.49.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^4.149.0"
  }
}
