{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sessions",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sessions-db",
      "database_id": "a1aade22-ff64-456a-a931-8f4b168899e3",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "APP_URL": "https://sessions.uririnathaniel.workers.dev",
    "STUDIO_NAME": "Sessions Studio",
    "STUDIO_EMAIL": "hello@sessionsstudio.ng",
    "STUDIO_PHONE": "+234 812 555 0142"
  },
  "observability": { "enabled": true }
}
