{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sessions",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/assets/*", "!/artwork/*", "!/brand/*", "!/favicon.ico", "!/favicon-32.png", "!/apple-touch-icon.png", "!/icon-*.png", "!/manifest.webmanifest"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sessions-db",
      "database_id": "a1aade22-ff64-456a-a931-8f4b168899e3",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "psych-records-media" }],
  "workers_dev": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "routes": [
    { "pattern": "psychstudios.ng/*", "zone_name": "psychstudios.ng" },
    { "pattern": "www.psychstudios.ng/*", "zone_name": "psychstudios.ng" }
  ],
  "vars": {
    "APP_URL": "https://psychstudios.ng",
    "STUDIO_NAME": "Psych Studios",
    "STUDIO_EMAIL": "bookings@psychstudios.com",
    "STUDIO_PHONE": "+234 906 744 9860"
  },
  "observability": { "enabled": true }
}
